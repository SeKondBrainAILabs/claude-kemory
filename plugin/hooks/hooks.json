{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 15,
            "statusMessage": "Loading Kemory memory context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__kemory_recall_memory|mcp__.*__kemory_get_context",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/rate-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreCompact\",\"additionalContext\":\"Context is about to be compacted. If this session established durable facts, decisions, or solved problems not yet in kemory, call kemory_consolidate_session (or kemory_store_memory for individual facts) NOW, before they are summarized away.\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/capture.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
